# Dependencies and build output
node_modules/
dist/
dist-single/
.vite/
.single-tmp/

# Secrets. Nothing here needs an env file today — this is preventive, because the
# repository is public and the cost of noticing too late is a rotated credential
# and a rewritten history.
.env
.env.*
*.local
!.env.example

# Build artefacts that live in the working tree
claudemary-llmaci.html
llmaci-src.zip
tools/shots/
# Rendered score, for listening to. Multi-megabyte binaries that are fully
# reproducible from `npm run rendermusic`, so there is no reason to version them
# -- and every reason not to, in a repo whose whole pitch is that it ships no
# audio assets.
tools/audio/

# Cloudflare Pages / Wrangler
.wrangler/

# Local scratch created by the device bridge (it cannot delete files)
_to_delete/
.gittest/

# Session handoff notes. Working state for resuming a task across sessions, not
# part of the product. Kept out of history deliberately -- but note it therefore
# only survives on the device clone, never in the ephemeral container.
HANDOFF.md

# Editor and OS droppings. The host is Windows, so Thumbs.db and desktop.ini are
# the ones that actually turn up here; .DS_Store is for anyone on a Mac.
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Raw fart-sample sources. The BAKED result lives in src/audio/fartSamples.js,
# which is what the game actually ships; keeping the originals here as well
# would double the audio in the repo for no benefit. Re-bake from wherever you
# keep the originals with `npm run bakefarts -- <dir>`.
sfx_an/
